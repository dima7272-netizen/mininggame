# Safe default: a missing adapter can never pretend that DEV was changed.
PUBLISH_ADAPTER=disabled
GITHUB_REPOSITORY=dima7272-netizen/mininggame
GITHUB_BRANCH=main
ALLOW_REAL_PROD=false

# Used by the documented backup helper. This is a database name, not a secret.
BALANCE_DB_NAME=site-creator-d1
BACKUP_DIR=backups

# Secrets must be added only to the deployment platform's encrypted secret store.
# Never put GITHUB_TOKEN, ROBLOX_API_KEY or invitation tokens in this file.
# For local work use `pnpm dev:github`: it reads the token from GitHub CLI only
# for the child process. ROBLOX_API_KEY remains in GitHub Actions secrets.
